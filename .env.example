VITE_APP_NAME=StudyFlow
VITE_APP_VERSION=0.1.0
VITE_DEVELOPMENT_MODE=true
VITE_TAURI_DEV_HOST=127.0.0.1

# Google Classroom integration
# Create a Google Cloud project, enable the Classroom API, and create an OAuth
# client ID of type "Web application" with http://localhost:1420 as an
# authorized JavaScript origin. Copy the client ID here to enable real sync.
# Leave empty to keep the app in development mode without a fake connection.
VITE_GOOGLE_CLIENT_ID=

# Windows download
# Keep false and empty until a real installer is released.
VITE_WINDOWS_DOWNLOAD_READY=false
VITE_WINDOWS_DOWNLOAD_URL=
