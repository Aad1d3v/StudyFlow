[TEMPLATE]
# Copy this file to .env and fill in the values. NEVER commit .env.
# Port for the backend. BACKEND_PORT is used (not PORT) to avoid colliding
# with a PORT variable that some Windows environments inherit.
BACKEND_PORT=8787
# Comma-separated origins allowed to call the backend: the dev server origin
# plus the origins the packaged Tauri app (WebView2) fetches from.
ALLOWED_ORIGIN=http://localhost:1420,http://127.0.0.1:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
# Provider secrets live only on the backend — never in the desktop app.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
# Optional: override the persisted auth secret (a random one is generated in backend/data/).
AUTH_SECRET=

# Local dev only: allow the school proxy (/school-proxy) to reach loopback
# addresses for fixture testing. NEVER enable in production — it bypasses the
# SSRF protection.
SCHOOL_PROXY_ALLOW_LOOPBACK=1
# Contact form delivery — every message is stored in SQLite regardless. To
# also receive it by email, create a free key at https://resend.com and set:
RESEND_API_KEY=
CONTACT_EMAIL_TO=you@example.com
# Owner-only endpoint to read support messages (GET /api/contact with header
# X-Admin-Key). Pick any long random string; leave empty to disable.
CONTACT_ADMIN_KEY=
